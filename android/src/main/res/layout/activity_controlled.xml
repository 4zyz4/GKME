<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnControlledBack"
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/i18n_back"
                android:drawableLeft="@drawable/ic_back"
                android:paddingStart="8dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/i18n_controlled_mode"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Shizuku 环境卡片 -->
        <LinearLayout
            android:id="@+id/cardShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_surface"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/i18n_shizuku_environment"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnShizukuAction"
                style="@style/GamepadChip"
                android:text="@string/i18n_download_shizuku" />
        </LinearLayout>

        <!-- 悬浮窗保活开关（可选，关闭时不影响前台服务） -->
        <LinearLayout
            android:id="@+id/rowFloatingKeepAlive"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_surface"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/i18n_overlay_keep_alive"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchFloatingKeepAlive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 网页手柄卡片：选择网卡、当前地址与二维码 -->
        <LinearLayout
            android:id="@+id/cardWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_surface"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/i18n_web_gamepad"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/i18n_select_network_interface"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/spinnerWebInterface"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_small_btn" />

                <TextView
                    android:id="@+id/tvWebHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivWebQr"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/i18n_web_gamepad_qr_code"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- 手动 IP 卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_surface"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/i18n_ip_address"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etManualIp"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_small_btn"
                android:hint="@string/i18n_host_ip"
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnManualConnect"
                style="@style/GamepadChip"
                android:layout_marginStart="8dp"
                android:text="@string/i18n_connect_manually" />

            <Button
                android:id="@+id/btnRefreshDevices"
                style="@style/GamepadChip"
                android:layout_marginStart="6dp"
                android:text="@string/i18n_refresh" />
        </LinearLayout>

        <!-- 状态 -->
        <TextView
            android:id="@+id/tvControlledStatus"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg_surface"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:text="@string/i18n_not_started"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- 设备列表 -->
        <LinearLayout
            android:id="@+id/deviceListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
